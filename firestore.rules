rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
      );
    }

    // 1. User profiles: Users can read and write only their own records
    match /users/{userId} {
      allow read, write: if isOwner(userId) || (!isAuthenticated() && request.resource.data.email != null);
    }

    // 2. Orders & Google Play Purchases: Only the owner or system can access
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Verification codes & account deletion tokens
    match /verification_codes/{verifId} {
      allow read, write: if true;
    }

    match /account_deletion_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 4. Default fallback: requires authentication
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

